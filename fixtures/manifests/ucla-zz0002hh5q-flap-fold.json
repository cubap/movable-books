                }
              }
            },
            {
              "id": "https://cubap.github.io/movable-books/fixtures/manifests/ucla-zz0002hh5q-flap-fold.json/annotation/behavior",
              "type": "Annotation",
              "motivation": "describing",
              "label": { "en": ["Flap fold behavior"] },
              "body": {
                "type": "TextualBody",
                "value": "One continuous front sheet with a single hinged flap below the crease; the upper sheet never moves. Swinging the flap upward through 180 degrees turns its verso to the viewer and covers the lower part of the sheet, including the sitters' bodies, so that only their faces remain visible. The verso is face-down and therefore unrecorded in the fully expanded photograph; it is recovered as a region of the collapsed photograph. Flipping the card reveals the back, for which only a collapsed photograph is available; therefore the demo folds the flap flat before flipping.",
                "format": "text/plain",
                "language": "en"
              },
              "target": "https://cubap.github.io/movable-books/fixtures/manifests/ucla-zz0002hh5q-flap-fold.json/canvas/front-expanded"
            }
          ]
        }
